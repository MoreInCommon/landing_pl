# Copy required existing Storyblok credentials into .env.local privately.
STORYBLOK_TOKEN=

# Set true on the test deployment: noindex metadata and disallow in robots.txt.
# This does not replace hosting access protection.
SITE_PREVIEW_ENABLED=false

# Local migration scripts only. Never expose these with NEXT_PUBLIC_ variables.
STORYBLOK_MANAGEMENT_TOKEN=
STORYBLOK_SPACE_ID=
